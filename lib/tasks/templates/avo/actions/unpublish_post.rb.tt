# frozen_string_literal: true

class Avo::Actions::UnpublishPost < Avo::BaseAction
  self.name = "Unpublish"
  self.visible = -> { record.status == "published" }
  self.message = "Are you sure you want to unpublish this post?"
  self.confirm_button_label = "Unpublish"

  def handle(**args)
    records = Array(args[:records])
    failures = []

    records.each do |post|
      # Updates status to draft
      # Note: published_at is preserved for re-publishing with original date
      # To reset published_at, clear it manually before re-publishing
      unless post.update(status: "draft")
        failures << "#{post.title.presence || "Post ##{post.id}"}: #{post.errors.full_messages.join(", ")}"
      end
    end

    if failures.empty?
      succeed "Post(s) unpublished successfully!"
    elsif failures.length == records.length
      error "Failed to unpublish #{failures.length} post(s). #{failures.join("; ")}"
    else
      warn "Unpublished #{records.length - failures.length} post(s), #{failures.length} failed. #{failures.join("; ")}"
    end
  end
end
