# frozen_string_literal: true

class Avo::Actions::PublishPost < Avo::BaseAction
  self.name = "Publish"
  self.visible = -> { record.status != "published" }
  self.message = "Are you sure you want to publish this post?"
  self.confirm_button_label = "Publish"

  def handle(**args)
    records = Array(args[:records])
    failures = []

    records.each do |post|
      # Updates status to published
      # Note: published_at is auto-set by Bunko callback if blank
      # If published_at is already set (e.g. scheduled post), it will be preserved
      unless post.update(status: "published")
        failures << "#{post.title.presence || "Post ##{post.id}"}: #{post.errors.full_messages.join(", ")}"
      end
    end

    if failures.empty?
      succeed "Post(s) published successfully!"
    elsif failures.length == records.length
      error "Failed to publish #{failures.length} post(s). #{failures.join("; ")}"
    else
      warn "Published #{records.length - failures.length} post(s), #{failures.length} failed. #{failures.join("; ")}"
    end
  end
end
